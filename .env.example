# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_CALENDAR_ICAL_URL: Secret address in iCal format (.ics) from Google Calendar settings.
# Used by the server to compute live free/busy availability for client scheduling.
GOOGLE_CALENDAR_ICAL_URL=
GOOGLE_CALENDAR_INPERSON_ICAL_URL=
GOOGLE_CALENDAR_ONLINE_ICAL_URL=
